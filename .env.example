# ── Gemini AI (3 cadangan key) ──
GEMINI_API_KEY=AIza...key1...
GEMINI_API_KEY_2=AIza...key2...
GEMINI_API_KEY_3=AIza...key3...

# ── Fonnte WhatsApp API ──
FONNTE_API_KEY=your_fonnte_token_here

# ── Nomor WA Admin (format internasional tanpa +) ──
ADMIN_WA_NUMBER=628123456789

# ── Email System (Nodemailer + Gmail SMTP) ──
# Gunakan "App Password" dari akun Google (bukan password login biasa).
# WAJIB disimpan sebagai environment variable (jangan hardcode di kode).
GMAIL_SMTP_USER=your_gmail_address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_google_app_password_here

# (Opsional) Kalau mau override format "From" (tetap disarankan 1 akun yang sama)
# Contoh: MAIL_FROM="Nusabit Studio CS <cs.nusabit@gmail.com>"
MAIL_FROM=

# ── Email Admin ──
ADMIN_EMAIL=dzakifaisal11@gmail.com

# ── Netlify Blobs (untuk games & tiket) ──
NETLIFY_SITE_ID=your_site_id_here
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# ── Admin Ticket Key (OPSIONAL) ──
# Isi dengan SHA-256 hash dari password admin kamu
# Cara dapat hash: buka browser console, ketik:
#   crypto.subtle.digest('SHA-256', new TextEncoder().encode('passwordmu'))
#     .then(b => console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))
# 
# Jika TIDAK diset, sistem pakai hash default yang sudah hardcode di ticket.js
# Jika DISET, nilai ini HARUS berupa hash SHA-256, BUKAN password asli!
#
# Contoh (hash SHA-256 dari password "admin123"):
# ADMIN_TICKET_KEY=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
ADMIN_TICKET_KEY=
